{pkgs, ...}: let
  phpIntlPcov = pkgs.php85.buildEnv {
    extensions = {
      enabled,
      all,
    }:
      enabled
      ++ (with all; [
        intl
        pcov
      ]);
    extraConfig = ''
      pcov.enabled=1
    '';
  };
in {
  environment.systemPackages = with pkgs; [
    alejandra
    bat
    btop
    claude-code
    cocoapods
    coreutils
    curl
    direnv
    dive
    dnsmasq
    exiftool
    ext4fuse
    fastfetch
    fastlane
    ffmpeg
    fio
    freerdp
    gh
    ghostscript
    gnupg
    go
    gqrx
    hcloud
    htop
    hugo
    imagemagick
    iperf
    jq
    k6
    mermaid-cli
    mkcert
    mosquitto
    mtr
    mysql84
    ncdu
    nginx
    nil
    nixd
    nmap
    nodejs_25
    openocd
    phpIntlPcov
    phpIntlPcov.packages.composer
    pinentry_mac
    platformio
    prettier
    pv
    python315
    rclone
    ruby
    ruff
    rustup
    sox
    speedtest-cli
